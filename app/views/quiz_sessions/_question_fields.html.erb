<fieldset class="question-fields nested-fields" data-new-record="<%= f.object.new_record? %>">
  <div class="question-fields-header">
    <h4 class="question-position-label">Question</h4>
    <button type="button" class="btn btn-ghost btn-sm" data-action="nested-form#remove">✕ Remove</button>
  </div>

  <%= f.hidden_field :position, class: "question-position-input" %>
  <%= f.hidden_field :_destroy %>

  <div class="form-group">
    <%= f.label :question_text, "Question" %>
    <%= f.text_field :question_text, class: "form-control", required: true, placeholder: "What's the capital of…" %>
  </div>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :points, "Max points" %>
      <%= f.number_field :points, class: "form-control", required: true, min: 0, step: 100 %>
      <small class="field-note">fastest answers get it all, slowest get half</small>
    </div>
    <div class="form-group">
      <%= f.label :time_limit_seconds, "Time limit (seconds)" %>
      <%= f.number_field :time_limit_seconds, class: "form-control", required: true, min: 1 %>
    </div>
  </div>

  <p class="field-hint">Answers: tap the circle next to the right one</p>
  <% f.object.question_options.each do |opt| %>
    <%= f.fields_for :question_options, opt do |optf| %>
      <%= optf.hidden_field :position %>
      <div class="option-field">
        <span class="option-marker shape-bg-<%= opt.position %>" aria-hidden="true"></span>
        <%= optf.text_field :option_text, class: "form-control", placeholder: "Option #{opt.position}", required: true %>
        <%= f.radio_button :correct_position, opt.position, required: true, aria: { label: "Option #{opt.position} is correct" } %>
      </div>
    <% end %>
  <% end %>
</fieldset>
