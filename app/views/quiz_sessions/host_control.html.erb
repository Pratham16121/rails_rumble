<% content_for :title, "Hosting #{@quiz_session.title}" %>

<%= turbo_stream_from @quiz_session, :host %>

<%# Permanent so the join code tiles don't replay their entrance after every host action %>
<div id="<%= dom_id(@quiz_session, :host_header) %>" class="card host-header" data-turbo-permanent>
  <div>
    <p class="eyebrow">Hosting</p>
    <h2><%= @quiz_session.title %></h2>
  </div>
  <div class="join-info">
    <p class="scribble join-hint">join at <%= link_to join_url.delete_prefix("http://").delete_prefix("https://"), join_url(join_code: @quiz_session.join_code) %></p>
    <p class="join-code"><%= safe_join(@quiz_session.join_code.chars.each_with_index.map { |char, i| tag.span(char, style: "--i: #{i}") }) %></p>
  </div>
  <%# Only shown in the lobby (see .join-qr in application.css) %>
  <div class="join-qr" role="img" aria-label="QR code to join this quiz">
    <%= qr_code_svg(join_url(join_code: @quiz_session.join_code)) %>
    <p class="scribble">scan to join!</p>
  </div>
</div>

<div data-controller="sync" data-sync-url-value="<%= state_quiz_session_path(@quiz_session) %>">
  <%= render "host_game", quiz_session: @quiz_session %>
</div>
