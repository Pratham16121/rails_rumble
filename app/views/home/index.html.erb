<div class="card" style="text-align: center; padding: 4rem 2rem;">
  <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem; color: var(--primary);">Real-Time Quiz</h1>
  <p style="font-size: 1.2rem; color: var(--text-muted); margin-bottom: 2rem;">Host a quiz or join an existing one.</p>
  
  <div style="display: flex; gap: 1rem; justify-content: center;">
    <%= link_to 'Host a Quiz', start_path, class: 'btn', style: 'font-size: 1.2rem; padding: 1rem 2rem;' %>
    <%= link_to 'Join a Quiz', join_path, class: 'btn', style: 'background: #334155; font-size: 1.2rem; padding: 1rem 2rem;' %>
  </div>
</div>
